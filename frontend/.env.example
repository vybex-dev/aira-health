# Firebase client SDK config (Project settings → General → Your apps → SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the deployed backend, e.g. https://aira-backend.vercel.app/api
# Leave unset for local dev — Vite proxies /api to http://localhost:8787 automatically.
VITE_API_BASE_URL=
