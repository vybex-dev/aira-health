rules_version = '2';

// Aira — Firestore security rules
//
// Data model:
//   users/{uid}                              — profile doc (owner read/write only)
//   users/{uid}/logs/{logId}                 — health log entries (owner only)
//   users/{uid}/chats/{chatId}/messages/{id} — chat history (owner only)
//   users/{uid}/insights/{insightId}         — cached AI insights (owner read, server write)
//
// Principle: a user can only ever read or write documents nested under their
// own uid. There is no cross-user access, and no public/shared collection.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Basic shape guard for profile writes — prevents a client from writing
    // arbitrary top-level fields onto their own profile document.
    function isValidProfileUpdate() {
      let allowedKeys = [
        'uid', 'displayName', 'email', 'age', 'sex', 'heightCm', 'weightKg',
        'conditions', 'allergies', 'medications', 'createdAt'
      ];
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidProfileUpdate();
      allow update: if isOwner(uid) && isValidProfileUpdate();
      allow delete: if isOwner(uid);

      match /logs/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.uid == uid;
        allow update, delete: if isOwner(uid);
      }

      match /chats/{chatId} {
        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid);
          allow update, delete: if isOwner(uid);
        }
      }

      // Insights are generated server-side via the Admin SDK (which bypasses
      // rules), but we still allow the owning client to read their own cache.
      match /insights/{insightId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
