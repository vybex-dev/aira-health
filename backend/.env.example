# --- AI providers ---
# Groq: primary, low-latency chat completions. Free tier at https://console.groq.com
GROQ_API_KEY=

# Gemini 2.5 Flash: automatic fallback if Groq is unavailable/rate-limited.
# Free tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Firebase Admin (server-side auth verification) ---
# Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences (not real newlines) if setting via
# a single-line .env or the Vercel dashboard, e.g.:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExample...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# --- CORS ---
# Set to your deployed frontend origin in production, e.g. https://aira-health.vercel.app
# Defaults to "*" (any origin) if unset — fine for local dev, tighten before production.
CORS_ALLOWED_ORIGIN=*

# Local dev server port (the frontend's Vite proxy expects 8787 by default)
PORT=8787
